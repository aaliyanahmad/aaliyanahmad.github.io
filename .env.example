# Optional override for the canonical origin configured in src/data/site.ts.
# Use a complete HTTPS origin without a path.
NEXT_PUBLIC_SITE_URL=

# Optional: enables the server-rendered GitHub contribution calendar.
# Keep this server-only. Never rename it with a NEXT_PUBLIC_ prefix.
GITHUB_TOKEN=

# Browser-safe EmailJS identifiers for the project inquiry form.
# Configure the destination inbox in the EmailJS dashboard/template.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
